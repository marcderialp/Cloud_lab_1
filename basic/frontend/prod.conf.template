resolver 127.0.0.11 valid=10s;

ssl_certificate     /etc/nginx/certs/live/fullchain.pem;
ssl_certificate_key /etc/nginx/certs/live/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
add_header Strict-Transport-Security "max-age=31536000" always;

server {
    listen 80;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name app.${DOMAIN};
    location = /metrics { return 403; }
    location /static/ { set $up http://static; proxy_pass $up; include proxy.conf; }
    location /        { set $up http://core:8000; proxy_pass $up; include proxy.conf; }
}
server {
    listen 443 ssl;
    server_name lms.${DOMAIN};
    client_max_body_size 100m;
    location / { set $up http://moodle; proxy_pass $up; include proxy.conf; }
}
server {
    listen 443 ssl;
    server_name grafana.${DOMAIN};
    location / { set $up http://grafana:3000; proxy_pass $up; include proxy.conf; }
}
server {
    listen 443 ssl;
    server_name registry.${DOMAIN};
    client_max_body_size 0;
    location /v2/ { set $up http://registry:5000; proxy_pass $up; include proxy.conf; }
}
