resolver 127.0.0.11 valid=10s;

proxy_cache_path /var/cache/nginx/lab1 levels=1:2 keys_zone=lab1:10m max_size=200m inactive=10m use_temp_path=off;

map "${NODE}" $node { "" $hostname; default "${NODE}"; }
map $http_upgrade $connection_upgrade { default upgrade; "" ""; }

server {
    listen 127.0.0.1:8081;
    location = /stub_status { stub_status; }
}

ssl_certificate     /etc/nginx/certs/live/fullchain.pem;
ssl_certificate_key /etc/nginx/certs/live/privkey.pem;
ssl_password_file   /etc/nginx/certs/pass;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
add_header Strict-Transport-Security "max-age=31536000" always;

server {
    listen 80 default_server;
    include /etc/nginx/node.conf;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name app.${DOMAIN};
    include /etc/nginx/node.conf;
    location = /metrics { return 403; }
    location /static/ {
        set $up http://static;
        include /etc/nginx/cache.conf;
        add_header Strict-Transport-Security "max-age=31536000" always;
        proxy_cache_valid 200 1h;
        proxy_pass $up; include proxy.conf;
    }
    location / {
        set $up http://core:8000;
        include /etc/nginx/cache.conf;
        add_header Strict-Transport-Security "max-age=31536000" always;
        proxy_pass $up; include proxy.conf;
    }
}
server {
    listen 443 ssl;
    server_name lms.${DOMAIN};
    client_max_body_size 100m;
    location / { set $up http://moodle; proxy_pass $up; include proxy.conf; }
}
server {
    listen 443 ssl;
    server_name grafana.${DOMAIN};
    location / { set $up http://grafana:3000; proxy_pass $up; include proxy.conf; }
}
server {
    listen 8080;
    server_name mail.${DOMAIN};
    location / { set $up http://mailpit:8025; proxy_pass $up; include proxy.conf; }
}
