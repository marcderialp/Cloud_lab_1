# Everything has a default except NFS_SERVER; export only what you want to change
# before `docker stack deploy` (docker stack does not read .env: set -a; . ./.env; set +a)
NFS_SERVER=10.0.0.5                 # private IP of the atenea node (REQUIRED, printed by scripts/label-nodes.sh)
# production runs on this computer: DOMAIN defaults to localhost (self-signed certificate on 443).
# Only for a public server with a real domain:
# DOMAIN=lab1.example.com
# LE_EMAIL=you@example.com
IMAGE_REPO=omarcornejo/lab1grouph
TAG=1.0
NOTIFY_EMAIL=groupH@example.com
RELAY_HOST=smtp-relay.brevo.com
RELAY_PORT=587
RELAY_USER=
RELAY_PASSWORD=
# BACKUP_SCHEDULE="30 3 * * *"  RESTORE_TEST_SCHEDULE="0 5 * * 0"  RETENTION_DAYS=14
# NFS_PORT_MODE=host (default) | ingress (published on every node, then NFS_SERVER=127.0.0.1)
