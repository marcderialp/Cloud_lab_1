  {
   "id": 3,
   "type": "stat",
   "title": "Reviews",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(core_comments_total)"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Targets up",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(up == 1) / count(up)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.99
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Firing alerts",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
